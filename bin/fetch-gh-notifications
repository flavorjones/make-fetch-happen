#!/usr/bin/env ruby
# frozen_string_literal: true

# Turn GitHub notifications that need Mike's attention into Fizzy cards.
#
# Walks the unread notifications newest first and cards each mention, review
# request, assignment and repository security advisory; lib/fetch_gh_notifications
# decides what each kind of card looks like. A notification whose artifact
# already has a card (by its "ref" or "output" frontmatter, on any lane of the
# board) adds a comment to that card instead, linking the latest GitHub comment
# when there is one, and moves a Done card back to Next while its pull request, issue or
# discussion is open. Either way the notification is marked read, or done for an advisory,
# so it isn't processed again.
#
# Fizzy calls go through the `fizzy` CLI under a named profile, which decides
# the account and the credentials. Override with --profile and --board.

require "json"
require "open3"
require "optparse"
require_relative "../lib/fetch_gh_notifications"

options = {
  profile: "fetchbot_personal",
  board:   "https://app.fizzy.do/6097036/boards/03f3qct6t4hsg76apuu1jea6w",
  dry_run: false
}
OptionParser.new do |opts|
  opts.banner = "usage: #{$PROGRAM_NAME} [--profile NAME] [--board URL_OR_ID] [--dry-run]"
  opts.on("--profile NAME", "fizzy CLI profile (default: #{options[:profile]})") { |v| options[:profile] = v }
  opts.on("--board URL_OR_ID", "board URL or ID (default: #{options[:board]})") { |v| options[:board] = v }
  opts.on("--dry-run", "print the cards that would be created, create nothing") { options[:dry_run] = true }
end.parse!

$stdout.sync = true

PROFILE = options[:profile]
BOARD   = options[:board].split("/").last
DRY_RUN = options[:dry_run]

def gh_api(*args)
  command = [ "gh", "api", *args ]
  response, status = Open3.capture2e(*command)
  raise "gh api failed: #{response}" unless status.success?
  response.strip.empty? ? nil : JSON.parse(response)
end

def fizzy(*args)
  command = [ "fizzy", *args, "--quiet", "--profile", PROFILE ]
  stdout, stderr, status = Open3.capture3(*command)
  raise "`#{command.join(" ")}` failed: #{stderr.strip}" unless status.success?
  parsed = JSON.parse(stdout)
  parsed.is_a?(Hash) ? parsed.fetch("data", parsed) : parsed
end

# The default listing omits closed and not-now cards.
LANES = { "all" => "open", "closed" => "closed", "not_now" => "not-now" }.freeze
MARKS = { "read" => "PATCH", "done" => "DELETE" }.freeze

cards = LANES.flat_map do |lane, name|
  print "reading #{name} cards... "
  fizzy("card", "list", "--board", BOARD, "--all", "--indexed-by", lane).tap { puts it.size }
end
board = FetchGhNotifications::Board.new(cards)

print "reading notifications... "
notifications = gh_api("--paginate", "--slurp", "/notifications?per_page=50").flatten
puts notifications.size

# A repo whose advisories can't be listed yields no match, and the card falls
# back to linking the security page.
advisories = Hash.new do |cache, repo|
  cache[repo] = gh_api("--paginate", "--slurp", "/repos/#{repo}/security-advisories?per_page=100").flatten
rescue => e
  warn "could not list advisories for #{repo}: #{e.message}"
  cache[repo] = []
end

wanted = notifications.sort_by { |n| n["updated_at"] }.reverse

# `latest_comment_url` is null, or the subject itself, when the latest
# activity wasn't a comment.
def latest_comment_html_url(notification)
  url = notification.dig("subject", "latest_comment_url")
  return if url.nil? || url == notification.dig("subject", "url")

  gh_api(url)["html_url"]
rescue => e
  warn "could not read #{url}: #{e.message}"
end

def open?(notification)
  gh_api(notification.dig("subject", "url"))["state"] == "open"
rescue => e
  warn "could not read #{notification.dig("subject", "url")}: #{e.message}"
  false
end

def next_column_id
  @next_column_id ||= fizzy("column", "list", "--board", BOARD).find { |c| c["name"] == "Next" }.fetch("id")
end

count = 0

wanted.each do |n|
  item = FetchGhNotifications.route(n, advisories) or next

  if (existing = board.find(item))
    number  = existing["number"].to_s
    comment = item.activity_comment(latest_comment_html_url(n))
    # A card in Done comes back while its pull request, issue or discussion
    # is open.
    reactivate = existing["closed"] && item.reopens_while_open? && open?(n)

    if DRY_RUN
      puts "would comment ##{number}: #{comment}"
      puts "would move ##{number} to Next" if reactivate
    else
      fizzy("comment", "create", "--card", number, "--body", comment)
      puts "commented ##{number}: #{comment}"
      if reactivate
        fizzy("card", "column", number, "--column", next_column_id)
        existing["closed"] = false
        puts "moved ##{number} to Next"
      end
    end
  else
    if DRY_RUN
      puts "would card [#{item.tags.join(",")}]#{" golden" if item.golden?} #{item.title} (#{item.ref})"
      number = "new"
    else
      card = fizzy("card", "create", "--board", BOARD, "--title", item.title, "--description", item.description)
      number = card["number"].to_s
      item.tags.each { |tag| fizzy("card", "tag", number, "--tag", tag) }
      fizzy("card", "golden", number) if item.golden?
      puts "carded ##{number}: #{item.title}"
    end

    board.add(item, { "number" => number, "closed" => false })
    count += 1
  end

  gh_api("-X", MARKS.fetch(item.mark), "/notifications/threads/#{n["id"]}") unless DRY_RUN
end

puts "done (#{count} #{DRY_RUN ? "would be carded" : "carded"})"
