#!/usr/bin/env ruby
# frozen_string_literal: true

# Turn GitHub security-advisory notifications into golden Fizzy cards.
#
# Finds unread notifications that are repository security advisories. A report
# without an existing card becomes a new golden, tagged card; activity on a
# report that already has a card adds a comment to that card instead of
# creating a duplicate. Either way the notification is marked done so it isn't
# processed again.

require "json"
require "open3"
require "fizzy"

ACCOUNT = "6097036"
BOARD   = "03f3qct6t4hsg76apuu1jea6w"
COLUMN  = "maybe"
TAGS    = %w[oss security].freeze

def gh_api(*args)
  command = ["gh", "api", *args]
  puts "API: #{command}"
  response, status = Open3.capture2e(*command)
  raise "gh api failed: #{response}" unless status.success?
  response.strip.empty? ? nil : JSON.parse(response)
end

token = `op read --account my.1password.com "op://Private/app.fizzy.do API key/password"`.strip
abort "could not read Fizzy token from 1Password" if token.empty?

fizzy = Fizzy.client(access_token: token, base_url: "https://app.fizzy.do")

count = 0
before = nil

loop do
  query = "/notifications?per_page=50"
  query += "&before=#{before}" if before
  batch = gh_api(query)
  break if batch.empty?

  # Page by a time cursor, not page number: marking notifications done shrinks
  # the inbox, which would shift page-number offsets and skip items.
  oldest = batch.last["updated_at"]

  # Past its served window GitHub stops honoring `before` and replays recent
  # notifications, so the cursor stops moving backward. That's the real end.
  break if before && oldest >= before
  before = oldest

  advisories = batch.select do |n|
    n.dig("subject", "type") == "RepositoryAdvisory"
  end

  advisories.each do |n|
    repo      = n.dig("repository", "full_name")
    title     = n.dig("subject", "title")
    thread_id = n["id"]

    card_title = "#{repo.split('/').last}: #{title}"

    existing = fizzy.cards.list(account_id: ACCOUNT, board_ids: [BOARD])
                    .find { |c| c["title"] == card_title }

    if existing
      fizzy.comments.create(
        account_id:  ACCOUNT,
        card_number: existing["number"],
        body:        "<p>Someone commented on the report.</p>"
      )
      puts "commented ##{existing["number"]}: #{card_title}"
    else
      rel         = "https://github.com/#{repo}/security/advisories"
      description = "<table><tr><td>rel</td><td>#{rel}</td></tr></table>"

      card = fizzy.cards.create(
        account_id:  ACCOUNT,
        board_id:    BOARD,
        column_id:   COLUMN,
        title:       card_title,
        description: description
      )
      TAGS.each do |tag|
        fizzy.cards.tag(account_id: ACCOUNT, card_number: card["number"], tag_title: tag)
      end
      fizzy.cards.gold(account_id: ACCOUNT, card_number: card["number"])
      puts "carded ##{card["number"]}: #{card_title}"
    end

    # Mark the notification done so it isn't processed again.
    gh_api("-X", "DELETE", "/notifications/threads/#{thread_id}")

    count += 1
  end
end

puts "done (#{count} advisories)"
