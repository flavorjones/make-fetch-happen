#!/usr/bin/env ruby
# frozen_string_literal: true

# Turn GitHub security-advisory notifications into golden Fizzy cards.
#
# Finds unread notifications that are repository security advisories. A report
# without an existing card becomes a new golden, tagged card that links the
# advisory; activity on a report that already has a card adds a comment saying
# why GitHub notified instead of creating a duplicate. Either way the
# notification is marked done so it isn't processed again.
#
# Fizzy calls go through the `fizzy` CLI under a named profile, which decides
# the account and the credentials. Override with --profile and --board.

require "json"
require "open3"
require "optparse"
require_relative "../lib/fetch_gh_security"

options = {
  profile: "fetchbot_personal",
  board:   "https://app.fizzy.do/6097036/boards/03f3qct6t4hsg76apuu1jea6w"
}
OptionParser.new do |opts|
  opts.banner = "usage: #{$PROGRAM_NAME} [--profile NAME] [--board URL_OR_ID]"
  opts.on("--profile NAME", "fizzy CLI profile (default: #{options[:profile]})") { |v| options[:profile] = v }
  opts.on("--board URL_OR_ID", "board URL or ID (default: #{options[:board]})") { |v| options[:board] = v }
end.parse!

PROFILE = options[:profile]
BOARD   = options[:board].split("/").last
TAGS    = %w[oss security].freeze

def gh_api(*args)
  command = ["gh", "api", *args]
  puts "API: #{command}"
  response, status = Open3.capture2e(*command)
  raise "gh api failed: #{response}" unless status.success?
  response.strip.empty? ? nil : JSON.parse(response)
end

def fizzy(*args)
  command = ["fizzy", *args, "--quiet", "--profile", PROFILE]
  stdout, stderr, status = Open3.capture3(*command)
  raise "`#{command.join(" ")}` failed: #{stderr.strip}" unless status.success?
  parsed = JSON.parse(stdout)
  parsed.is_a?(Hash) ? parsed.fetch("data", parsed) : parsed
end

cards = fizzy("card", "list", "--board", BOARD, "--all")
# A repo whose advisories can't be listed yields no match, and the card falls
# back to linking the security page.
advisories = Hash.new do |cache, repo|
  cache[repo] = gh_api("--paginate", "--slurp", "/repos/#{repo}/security-advisories?per_page=100").flatten
rescue => e
  warn "could not list advisories for #{repo}: #{e.message}"
  cache[repo] = []
end

count = 0
before = nil

loop do
  query = "/notifications?per_page=50"
  query += "&before=#{before}" if before
  batch = gh_api(query)
  break if batch.empty?

  # Page by a time cursor, not page number: marking notifications done shrinks
  # the inbox, which would shift page-number offsets and skip items. Pages are
  # not sorted by updated_at (and can hold items newer than `before`), so take
  # the minimum rather than the last element.
  oldest = batch.map { |n| n["updated_at"] }.min

  # Past its served window GitHub stops honoring `before` and replays recent
  # notifications, so the cursor stops moving backward. That's the real end.
  break if before && oldest >= before
  before = oldest

  advisory_notifications = batch.select do |n|
    n.dig("subject", "type") == "RepositoryAdvisory"
  end

  advisory_notifications.each do |n|
    repo      = n.dig("repository", "full_name")
    title     = n.dig("subject", "title")
    thread_id = n["id"]

    card_title = "#{repo.split('/').last}: #{title}"

    existing = cards.find { |c| c["title"] == card_title }

    if existing
      fizzy("comment", "create", "--card", existing["number"].to_s, "--body", FetchGhSecurity.activity_comment(n["reason"]))
      puts "commented ##{existing["number"]}: #{card_title}"
    else
      advisory    = FetchGhSecurity.advisory_for(n, advisories[repo])
      description = FetchGhSecurity.frontmatter(repo, advisory)

      card = fizzy("card", "create", "--board", BOARD, "--title", card_title, "--description", description)
      number = card["number"].to_s
      TAGS.each { |tag| fizzy("card", "tag", number, "--tag", tag) }
      fizzy("card", "golden", number)
      cards << card
      puts "carded ##{number}: #{card_title}"
    end

    # Mark the notification done so it isn't processed again.
    gh_api("-X", "DELETE", "/notifications/threads/#{thread_id}")

    count += 1
  end
end

puts "done (#{count} advisories)"
